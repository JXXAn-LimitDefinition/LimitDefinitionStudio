---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';

const about = site.about;
const caps = site.capabilities;
const tl = site.timeline;
---

<BaseLayout title="关于 — Limit Definition Studio" description="极限定义工作室的理念、历程与能力范围。">
  <section class="hero grid-lines">
    <div class="container">
      <SectionHeading kicker={about.kicker} title={about.heading} eTitle="Beyond the unknown" />
      <div class="about-grid">
        <div class="about-lead" data-reveal>
          <p class="display--cn about-slogan">{about.slogan}</p>
          <p class="about-copy">{about.lead}</p>
        </div>
        <div class="about-mission" data-reveal>
          <h2 class="small-caps mission-title">{about.missionTitle}</h2>
          <p class="mission-text">{about.mission}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading kicker={caps.kicker} title={caps.title} />
      <div class="cap-grid">
        {caps.items.map((it, i) => (
          <div class="cap-item" data-reveal>
            <span class="cap-index small-caps">0{i + 1}</span>
            <h3 class="display--cn">{it.title}</h3>
            <p class="muted">{it.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="timeline">
        <h2 class="small-caps timeline-title">{tl.kicker}</h2>
        <ul>
          {tl.items.map((it) => (
            <li class="timeline-item" data-reveal>
              <span class="timeline-year small-caps">{it.year}</span>
              <p>{it.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-section);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-slogan {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.08;
    margin-bottom: 1.4rem;
  }

  .about-copy {
    max-width: 44ch;
    color: var(--c-text-soft);
  }

  .about-copy b {
    color: var(--c-text);
  }

  .about-mission {
    border-left: 2px solid var(--c-accent);
    padding: 0.4rem 0 0.4rem 1.5rem;
  }

  .mission-title {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-bottom: 0.6rem;
  }

  .mission-text {
    font-family: var(--font-display-cn);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--c-text);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cap-item {
    border: 1px solid var(--c-border-soft);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    padding: 1.75rem;
  }

  .cap-index {
    font-size: 0.8rem;
    color: var(--c-accent);
  }

  .cap-item h3 {
    font-size: 1.3rem;
    margin: 0.7rem 0 0.5rem;
  }

  .cap-item p {
    font-size: var(--fs-small);
  }

  .timeline {
    max-width: 46rem;
  }

  .timeline-title {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-bottom: 1.5rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--c-border-soft);
  }

  .timeline-year {
    color: var(--c-accent);
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }

  .timeline-item p {
    color: var(--c-text-soft);
  }

  @media (max-width: 860px) {
    .about-grid,
    .cap-grid {
      grid-template-columns: 1fr;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
