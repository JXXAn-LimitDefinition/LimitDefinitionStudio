---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 页面未找到 — Limit Definition Studio" description="页面不存在。" noindex>
  <section class="section">
    <div class="container notfound">
      <span class="kicker">404</span>
      <h1 class="display--cn">这一条边界，还没有被定义。</h1>
      <p class="muted">你访问的页面不存在或已被移动。</p>
      <div class="notfound-actions">
        <a class="btn btn--solid" href="/">回到首页</a>
        <a class="btn btn--ghost" href="/works">浏览作品</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(5rem, 12vw, 10rem);
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .notfound .kicker::before {
    display: none;
  }

  .notfound h1 {
    font-size: var(--fs-h1);
    margin-top: 1.2rem;
    max-width: 22ch;
  }

  .notfound p {
    margin-top: 1rem;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
