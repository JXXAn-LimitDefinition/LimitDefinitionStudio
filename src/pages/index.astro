---
import { B } from '../lib/base';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import TeamCard from '../components/TeamCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';
import { getWorks, getNews } from '../lib/content';

const featured = getWorks().filter((w) => w.data.featured).slice(0, 3);
const latestNews = getNews().slice(0, 3);

const team = site.team.slice(0, 3);
const pos = site.positioning;
const sec = site.sections;
---

<BaseLayout title="Limit Definition Studio — 超越未知，定义极限">
  <Hero />

  <!-- Featured works -->
  <section class="section">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;">
        <SectionHeading kicker={sec.works.kicker} title={sec.works.title} eTitle={sec.works.en} />
        <a class="btn btn--ghost" href={B('/works')}>{sec.works.seeAll}</a>
      </div>
      <div class="grid">
        {featured.map((p) => <ProjectCard title={p.data.title} description={p.data.description} href={`/works/${p.id}/`} cover={p.data.cover} tags={p.data.tags} status={p.data.status} year={p.data.year} />)}
      </div>
    </div>
  </section>

  <!-- Positioning / capability -->
  <section class="section section--tight">
    <div class="container positioning">
      <div class="positioning-copy" data-reveal>
        <span class="kicker">{pos.kicker}</span>
        <h2 class="display--cn positioning-title">{pos.title}</h2>
      </div>
      <ul class="positioning-list">
        {pos.items.map((it, i) => (
          <li class="positioning-item" data-reveal>
            <span class="positioning-index small-caps">0{i + 1}</span>
            <div>
              <h3 class="display--cn">{it.title}</h3>
              <p class="muted">{it.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Team preview -->
  <section class="section">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;">
        <SectionHeading kicker={sec.team.kicker} title={sec.team.title} />
        <a class="btn btn--ghost" href={B('/team')}>{sec.team.seeAll}</a>
      </div>
      <div class="grid grid--3">
        {team.map((m) => <TeamCard {...m} />)}
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;">
        <SectionHeading kicker={sec.news.kicker} title={sec.news.title} />
        <a class="btn btn--ghost" href={B('/news')}>{sec.news.seeAll}</a>
      </div>
      <div class="grid grid--3">
        {latestNews.map((n) => (
          <NewsCard title={n.data.title} description={n.data.description} href={`/news/${n.id}/`} date={n.data.pubDate} cover={n.data.cover} tags={n.data.tags} />
        ))}
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .positioning {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .positioning-title {
    font-size: var(--fs-h1);
    line-height: 1.15;
  }

  .positioning-list {
    display: flex;
    flex-direction: column;
  }

  .positioning-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--c-border-soft);
  }

  .positioning-item:last-child {
    border-bottom: 1px solid var(--c-border-soft);
  }

  .positioning-index {
    font-size: 0.8rem;
    color: var(--c-accent);
    padding-top: 0.2rem;
  }

  .positioning-item h3 {
    font-size: 1.25rem;
  }

  .positioning-item p {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
  }

  @media (max-width: 860px) {
    .grid,
    .grid--3 {
      grid-template-columns: 1fr;
    }
    .positioning {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 861px) and (max-width: 1080px) {
    .grid,
    .grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
