---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const socials = [
  { label: 'Bilibili', handle: '@LimitDefinition', url: '#' },
  { label: 'Weibo', handle: '@极限定义工作室', url: '#' },
  { label: 'X / Twitter', handle: '@LimitDefStudio', url: '#' },
  { label: 'Twitch', handle: '@LimitDefinition', url: '#' },
];

const email = 'business@limitdefinition.studio';
---

<BaseLayout title="联系 / 合作 — Limit Definition Studio" description="与极限定义工作室取得联系：商务合作、媒体交流、试玩与 Wishlist。">
  <section class="section">
    <div class="container">
      <SectionHeading kicker="Contact" title="联系 / 合作" eTitle="Let's shape the edge together" lead="无论是商务、媒体还是试玩交流，欢迎与我们联系。" />

      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">邮箱</h2>
            <a class="info-email display--cn" href={`mailto:${email}`}>{email}</a>
          </div>

          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">社媒</h2>
            <ul class="social-list">
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="social-label">{s.label}</span>
                    <span class="social-handle muted">{s.handle} ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">试玩 / Wishlist</h2>
            <p class="muted">想第一时间体验我们的作品？关注下方按钮，把我们加进你的愿望单。</p>
            <div class="info-actions">
              <a class="btn btn--solid" href="#" rel="noopener">预约试玩</a>
              <a class="btn btn--ghost" href="#" rel="noopener">加入 Wishlist</a>
            </div>
          </div>
        </div>

        <form class="form" data-reveal method="post" action={`mailto:${email}`} enctype="text/plain">
          <p class="form-note small-caps">给我们留言</p>

          <label class="field">
            <span>你的称呼 *</span>
            <input type="text" name="name" required autocomplete="name" placeholder="怎么称呼你" />
          </label>

          <label class="field">
            <span>邮箱 *</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>

          <label class="field">
            <span>类型</span>
            <select name="type">
              <option value="business">商务合作</option>
              <option value="media">媒体交流</option>
              <option value="join">加入我们</option>
              <option value="other">其他</option>
            </select>
          </label>

          <label class="field">
            <span>想说的 *</span>
            <textarea name="message" rows="5" required placeholder="简单说说你的想法"></textarea>
          </label>

          <button type="submit" class="btn btn--solid">发送留言</button>
          <p class="form-hint muted">提交将打开你的邮件客户端发送，我们会尽快回复。</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .info-title {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-bottom: 0.7rem;
  }

  .info-email {
    font-size: 1.35rem;
    word-break: break-all;
    transition: color var(--speed) var(--ease-out);
  }
  .info-email:hover {
    color: var(--c-accent);
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .social-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--c-border-soft);
  }

  .social-label {
    color: var(--c-text-soft);
  }
  .social-label:hover {
    color: var(--c-accent);
  }
  .social-handle {
    font-size: var(--fs-small);
  }

  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .form {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-note {
    font-size: 0.75rem;
    color: var(--c-accent);
    margin-bottom: 0.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field span {
    font-size: 0.88rem;
    color: var(--c-text-soft);
  }

  input,
  select,
  textarea {
    width: 100%;
    background: var(--c-bg-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-text);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.8rem 0.9rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 0;
    border-color: var(--c-accent);
  }

  textarea {
    resize: vertical;
  }

  .form-hint {
    font-size: 0.8rem;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
