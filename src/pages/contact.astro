---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';

const socials = site.contact.socials;
const email = site.contact.email;
const c = site.contact;
// 试玩 / Wishlist 两个按钮：文字与跳转链接都可在编辑器里配置。留空则不跳转（保持 #）。
const trialUrl = (c.trialUrl || '').trim();
const wishlistUrl = (c.wishlistUrl || '').trim();
const btnLink = (u) => (/^https?:\/\//i.test(u) ? { href: u, target: '_blank', rel: 'noopener noreferrer' } : { href: '#' });
---

<BaseLayout title="联系 / 合作 — Limit Definition Studio" description="与极限定义工作室取得联系：商务合作、媒体交流、试玩与 Wishlist。">
  <section class="section">
    <div class="container">
      <SectionHeading kicker={c.kicker} title={c.title} eTitle={c.en} lead={c.lead} />

      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">邮箱</h2>
            <a class="info-email display--cn" href={`mailto:${email}`}>{email}</a>
          </div>

          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">社媒</h2>
            <ul class="social-list">
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="social-label">{s.label}</span>
                    <span class="social-handle muted">{s.handle} ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="info-block" data-reveal>
            <h2 class="small-caps info-title">试玩 / Wishlist</h2>
            <p class="muted">想第一时间体验我们的作品？关注下方按钮，把我们加进你的愿望单。</p>
            <div class="info-actions">
              <a class="btn btn--solid" {...btnLink(trialUrl)}>{c.trialText || '预约试玩'}</a>
              <a class="btn btn--ghost" {...btnLink(wishlistUrl)}>{c.wishlistText || '加入 Wishlist'}</a>
            </div>
          </div>
        </div>

        <form class="form" data-reveal id="contact-form" method="POST" action="https://api.web3forms.com/submit">
          <p class="form-note small-caps">{c.formNote}</p>

          <input type="hidden" name="access_key" value="19062a0e-a909-44f0-b9f0-93f6620b561a" />
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

          <label class="field">
            <span>你的称呼 *</span>
            <input type="text" name="name" required autocomplete="name" placeholder="怎么称呼你" />
          </label>

          <label class="field">
            <span>邮箱 *</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>

          <label class="field">
            <span>类型</span>
            <select name="type">
              <option value="business">商务合作</option>
              <option value="media">媒体交流</option>
              <option value="join">加入我们</option>
              <option value="other">其他</option>
            </select>
          </label>

          <label class="field">
            <span>想说的 *</span>
            <textarea name="message" rows="5" required placeholder="简单说说你的想法"></textarea>
          </label>

          <button type="submit" class="btn btn--solid">发送留言</button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          <p class="form-hint muted">点击发送后，我们会尽快回复你。</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const statusEl = document.getElementById('form-status');
    if (form && statusEl) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const oldText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '发送中…';
        statusEl.textContent = '';
        statusEl.className = 'form-status';
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });
          const data = await res.json();
          if (data.success) {
            form.reset();
            statusEl.textContent = '✅ 已收到你的留言，我们会尽快回复你！';
            statusEl.className = 'form-status ok';
          } else {
            throw new Error(data.message || '发送失败，请稍后重试');
          }
        } catch (err) {
          statusEl.textContent = '❌ 发送失败：' + (err && err.message ? err.message : '请稍后重试');
          statusEl.className = 'form-status err';
        } finally {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .info-title {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-bottom: 0.7rem;
  }

  .info-email {
    font-size: 1.35rem;
    word-break: break-all;
    transition: color var(--speed) var(--ease-out);
  }
  .info-email:hover {
    color: var(--c-accent);
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .social-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--c-border-soft);
  }

  .social-label {
    color: var(--c-text-soft);
  }
  .social-label:hover {
    color: var(--c-accent);
  }
  .social-handle {
    font-size: var(--fs-small);
  }

  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .form {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-note {
    font-size: 0.75rem;
    color: var(--c-accent);
    margin-bottom: 0.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field span {
    font-size: 0.88rem;
    color: var(--c-text-soft);
  }

  input,
  select,
  textarea {
    width: 100%;
    background: var(--c-bg-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-text);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.8rem 0.9rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 0;
    border-color: var(--c-accent);
  }

  textarea {
    resize: vertical;
  }

  .form-hint {
    font-size: 0.8rem;
  }

  .form-status {
    font-size: 0.9rem;
    min-height: 1.2em;
  }
  .form-status.ok {
    color: var(--c-accent);
  }
  .form-status.err {
    color: #ff5c5c;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
