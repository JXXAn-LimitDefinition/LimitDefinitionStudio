---
import { B } from '../lib/base';
import site from '../data/site.json';
import theme from '../data/theme.json';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string;
}

const {
  title = `${site.brand.name} — ${site.brand.tagline}`,
  description = '极限定义游戏工作室（Limit Definition Studio）官网。代表作、团队、关于与最新动态。我们以锋利与极致的方式，探索游戏表达的边界。',
  image = '/logo.jpg',
  type = 'website',
  noindex = false,
  canonical = Astro.url.href,
} = Astro.props;

const ogImage = new URL(B(image), Astro.site ?? Astro.url).href;
const siteName = site.brand.name;

// 主题令牌：把 theme.json 展开成 CSS 自定义属性（全局 :root 生效，供所有组件引用）。
const themeVars = {
  'c-bg': theme.colors.bg,
  'c-bg-2': theme.colors.bg2,
  'c-surface': theme.colors.surface,
  'c-border': theme.colors.border,
  'c-border-soft': theme.colors.borderSoft,
  'c-text': theme.colors.text,
  'c-text-soft': theme.colors.textSoft,
  'c-text-muted': theme.colors.textMuted,
  'c-accent': theme.colors.accent,
  'c-accent-deep': theme.colors.accentDeep,
  'c-accent-glow': 'color-mix(in srgb, var(--c-accent) 35%, transparent)',
  'gradient-shard': 'linear-gradient(135deg, #ffffff 0%, #c9c9cf 48%, #5c5c66 100%)',
  'font-sans': theme.fonts.sans,
  'font-display-cn': theme.fonts.displayCn,
  'font-display-en': theme.fonts.displayEn,
  'fs-hero': theme.sizes.hero,
  'fs-h1': theme.sizes.h1,
  'fs-h2': theme.sizes.h2,
  'fs-h3': theme.sizes.h3,
  'fs-body': theme.sizes.body,
  'fs-small': theme.sizes.small,
  'space-section': 'clamp(4.5rem, 9vw, 8.5rem)',
  'gutter': 'clamp(1.25rem, 4vw, 4rem)',
  'radius': theme.radius.base,
  'radius-lg': theme.radius.lg,
  'ease-out': theme.motion.easeOut,
  'speed': theme.motion.speed,
  'focus-ring': '2px solid var(--c-accent)',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content={theme.colors.bg} />
    <link rel="icon" type="image/svg+xml" href={B('/favicon.svg')} />
    <link rel="apple-touch-icon" href={B('/logo.jpg')} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="format-detection" content="telephone=no" />

    <!-- Latin display font (sharp, geometric). Chinese uses system serif/sans to keep bundles slim. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll observer
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.7rem 1rem;
    background: var(--c-accent);
    color: var(--c-text);
    font-family: var(--font-display-en);
  }
  .skip-link:focus {
    left: 0;
  }
</style>

<style is:global define:vars={themeVars}>
  :root {
    color-scheme: dark;
  }
</style>
