---
import { B } from '../lib/base';
interface Props {
  title: string;
  description: string;
  href: string;
  cover?: string;
  tags?: string[];
  status?: string;
  year?: number;
}
const { title, description, href, cover, tags = [], status, year } = Astro.props;

const statusLabel: Record<string, string> = {
  released: '已发布',
  'in-development': '开发中',
  prototype: '原型',
};
---

<a class="project-card" href={B(href)} data-reveal>
  <div class="card-media">
    {cover ? (
      <img src={cover} alt={`${title} 封面`} loading="lazy" decoding="async" />
    ) : (
      <div class="card-media-fallback">
        <img src={B('/logo.jpg')} alt="" aria-hidden="true" />
      </div>
    )}
    {status && <span class="card-status">{statusLabel[status] ?? status}</span>}
    {year && <span class="card-year small-caps">{year}</span>}
  </div>

  <div class="card-body">
    <h3 class="card-title display--cn">{title}</h3>
    <p class="card-desc muted">{description}</p>
    {tags.length > 0 && (
      <ul class="card-tags">
        {tags.slice(0, 4).map((t) => <li>{t}</li>)}
      </ul>
    )}
    <span class="card-more small-caps">查看详情 →</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    border: 1px solid var(--c-border-soft);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    overflow: hidden;
    transition: transform var(--speed) var(--ease-out), border-color var(--speed) var(--ease-out), box-shadow var(--speed) var(--ease-out);
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--c-accent);
    box-shadow: 0 22px 45px -22px color-mix(in srgb, var(--c-accent) 35%, transparent);
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-bg-2);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .project-card:hover .card-media img {
    transform: scale(1.05);
  }

  .card-media-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    filter: grayscale(0.4);
  }

  .card-media-fallback img {
    width: 90%;
    height: 90%;
    object-fit: contain;
  }

  .card-status,
  .card-year {
    position: absolute;
    top: 0.9rem;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
    backdrop-filter: blur(4px);
  }

  .card-status {
    left: 0.9rem;
    background: var(--c-accent);
    color: var(--c-text);
  }

  .card-year {
    right: 0.9rem;
    background: color-mix(in srgb, var(--c-bg) 65%, transparent);
    color: var(--c-text-soft);
  }

  .card-body {
    padding: 1.35rem 1.35rem 1.5rem;
  }

  .card-title {
    font-size: var(--fs-h3);
  }

  .card-desc {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .card-tags li {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    color: var(--c-text-soft);
  }

  .card-more {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.72rem;
    color: var(--c-accent);
  }
</style>
